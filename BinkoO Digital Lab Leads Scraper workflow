      "parameters": {
        "jsCode": "const data = $json;\n\n// On récupère directement le texte isolé par le node précédent !\nlet md = data.texte_brut || \"\";\n\nif (!md) return { texte_ia: \"VIDE\", liens_menu: \"VIDE\", site_url: data.url || \"\" };\n\n// ... (Tout le reste de ton code avec la fonction supprimerBalises, etc., reste intact) ...\n\n// --- 2. FONCTION DE NETTOYAGE ROBUSTE (Sans Regex, sans Map) ---\nfunction supprimerBalises(texte, debut, fin) {\n    let segments = texte.split(debut);\n    let resultat = segments[0];\n    for (let i = 1; i < segments.length; i++) {\n        let positionFin = segments[i].indexOf(fin);\n        if (positionFin !== -1) {\n            resultat += segments[i].substring(positionFin + fin.length);\n        } else {\n            resultat += segments[i];\n        }\n    }\n    return resultat;\n}\n\n// --- 3. EXTRACTION DES LIENS DU MENU ---\nconst liensExtraits = [];\nconst motsInterdits = ['login', 'register', 'cart', 'panier', 'checkout', 'wp-content', 'tag', 'category', 'search', 'recherche', 'property', 'status', 'label'];\n\nlet blocsLiens = md.split('](');\nfor (let i = 0; i < blocsLiens.length - 1; i++) {\n    let partieTexte = blocsLiens[i];\n    let partieUrl = blocsLiens[i+1];\n    \n    let debutTexte = partieTexte.lastIndexOf('[');\n    let finUrl = partieUrl.indexOf(')');\n    \n    if (debutTexte !== -1 && finUrl !== -1) {\n        let texteLien = partieTexte.substring(debutTexte + 1).trim();\n        let urlLien = partieUrl.substring(0, finUrl).trim();\n        \n        let urlBasse = urlLien.toLowerCase();\n        let estInutile = false;\n        for (let mot of motsInterdits) {\n            if (urlBasse.includes(mot)) { estInutile = true; break; }\n        }\n        \n        if (!estInutile && texteLien.length < 50 && urlLien.startsWith('http')) {\n            liensExtraits.push(texteLien + ' : ' + urlLien);\n        }\n    }\n}\n\n// --- 4. NETTOYAGE DU CONTENU ---\nlet textePropre = md;\n\n// Supprimer les images Base64 (très lourd)\ntextePropre = supprimerBalises(textePropre, 'data:image', ')');\n\n// Supprimer les sources \ntextePropre = supprimerBalises(textePropre, '');\n\n// Supprimer les chevrons de Crawl4AI ⟨X⟩\ntextePropre = supprimerBalises(textePropre, '⟨', '⟩');\n\n// Supprimer les balises images Markdown ![alt]\ntextePropre = supprimerBalises(textePropre, '![', ']');\n\n// --- 5. FILTRAGE LIGNE PAR LIGNE ---\nconst lignes = textePropre.split('\\n');\nconst lignesFinales = [];\n\nfor (let ligne of lignes) {\n    let l = ligne.trim();\n    \n    // On enlève les résidus de liens Markdown [Texte](URL) pour ne garder que le Texte\n    while (l.includes('](')) {\n        let debut = l.indexOf('[');\n        let milieu = l.indexOf('](', debut);\n        let fin = l.indexOf(')', milieu);\n        if (debut !== -1 && milieu !== -1 && fin !== -1) {\n            l = l.substring(0, debut) + l.substring(debut + 1, milieu) + l.substring(fin + 1);\n        } else { break; }\n    }\n\n    // Filtrage qualité\n    if (l.length < 60) continue;\n\n    let mots = l.split(' ').filter(m => m.length > 0);\n    let aPonctuation = l.includes('.') || l.includes('!') || l.includes('?');\n    let texteBas = l.toLowerCase();\n    \n    // Éjecter les listes sans ponctuation (ex: listes de quartiers ou services)\n    if (mots.length > 12 && !aPonctuation) continue;\n    \n    // Éjecter les lignes de prix ou budgets isolées\n    if ((texteBas.includes('f cfa') || texteBas.includes('budget')) && !aPonctuation) continue;\n    \n    // Éjecter les caractéristiques techniques courtes\n    if ((texteBas.startsWith('lits:') || texteBas.startsWith('baignoires:') || texteBas.startsWith('parcelle')) && mots.length < 10) continue;\n\n    lignesFinales.push(l);\n}\n\n// --- 6. RÉASSEMBLAGE ET FORMATAGE ---\nlet resultatFinal = lignesFinales.join('\\n\\n');\n\n// Nettoyage des symboles Markdown restants\nresultatFinal = resultatFinal.split('#').join('').split('*').join('').split('`').join('');\n\n// Suppression des doubles espaces\nwhile (resultatFinal.includes('  ')) {\n    resultatFinal = resultatFinal.split('  ').join(' ');\n}\n\n// Déduplication des liens\nconst liensUniques = [...new Set(liensExtraits)];\n\nreturn {\n    texte_ia: resultatFinal.substring(0, 3800).trim() || \"Aucune description pertinente extraite.\",\n    liens_menu: liensUniques.slice(0, 15).join('\\n') || \"Menu non trouvé.\",\n    site_url: data.results?.[0]?.url || data.url || \"\"\n};"
      },
