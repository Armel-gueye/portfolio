      "parameters": {
        "jsCode": "let newItems = [];\n\n// Règles strictes pour tes deux marchés\nconst countries = [\n  { code: \"226\", length: 8, mobilePrefixes: [\"50\", \"51\", \"52\", \"53\", \"54\", \"55\", \"56\", \"57\", \"60\", \"61\", \"62\", \"63\", \"64\", \"65\", \"66\", \"67\", \"70\", \"71\", \"72\", \"73\", \"74\", \"75\", \"76\", \"77\", \"01\", \"02\", \"03\", \"05\", \"06\", \"07\"] },\n  { code: \"225\", length: 10, mobilePrefixes: [\"01\", \"05\", \"07\"] }\n];\n\nfor (const item of $input.all()) {\n  let leadData = item.json;\n  let rawNumbersText = \"\";\n\n  // 1. On récupère les numéros existants OU les numéros bruts du scraping\n  if (leadData.whatsapp_valides && leadData.whatsapp_valides.trim() !== \"\") {\n     rawNumbersText = leadData.whatsapp_valides;\n  } else {\n     rawNumbersText = [leadData.phone, leadData.phoneMaps, leadData.phoneWebsite].filter(Boolean).join(',');\n  }\n\n  if (!rawNumbersText) continue;\n\n  // 2. Découpage et nettoyage\n  const rawArray = rawNumbersText.split(/[\\s,/\\-\\.]+/);\n  const validNumbers = [];\n  const waLinks = [];\n\n  for (let chunk of rawArray) {\n    let digits = chunk.replace(/\\D/g, \"\");\n    if (digits.startsWith('00')) digits = digits.substring(2);\n    if (digits.length < 6) continue;\n\n    let detectedCountry = null;\n    let localNumber = \"\";\n\n    // Identification de l'indicatif\n    for (let country of countries) {\n      if (digits.startsWith(country.code)) {\n        detectedCountry = country;\n        localNumber = digits.slice(country.code.length);\n        break;\n      }\n    }\n\n    // Déduction si pas d'indicatif\n    if (!detectedCountry) {\n      if (digits.length === 8) {\n        detectedCountry = countries.find(c => c.code === \"226\");\n        localNumber = digits;\n      } else if (digits.length === 10) {\n        detectedCountry = countries.find(c => c.code === \"225\");\n        localNumber = digits;\n      }\n    }\n\n    // 3. Validation finale du mobile\n    if (detectedCountry && localNumber.length === detectedCountry.length) {\n      const isMobile = detectedCountry.mobilePrefixes.some(pref => localNumber.startsWith(pref));\n      if (isMobile) {\n        const fullInternationalNumber = detectedCountry.code + localNumber;\n        // Anti-doublons\n        if (!validNumbers.includes(fullInternationalNumber)) {\n          validNumbers.push(fullInternationalNumber);\n          waLinks.push(`https://wa.me/${fullInternationalNumber}`);\n        }\n      }\n    }\n  }\n\n  // 4. On pousse le lead seulement s'il a au moins un numéro valide\n  if (validNumbers.length > 0) {\n    leadData.numeros_valides_str = validNumbers.join(\", \");\n    leadData.liens_whatsapp_str = waLinks.join(\"\\n\");\n    leadData.incrementer_etape = true;\n    newItems.push({ json: leadData });\n  }\n}\n\nreturn newItems;"
